[
    {
        "id": "pricetimerflow",
        "type": "tab",
        "label": "price-timer dev",
        "disabled": false,
        "info": "Sample flow for node-red-contrib-price-timer. Click the inject node to run price-timer. priceLevel 480 is below the series for longer than 8 hours, so the schedule covers that whole stretch."
    },
