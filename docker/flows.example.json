                "vt": "json"
            },
            {
                "p": "hours",
                "v": "8",
                "vt": "num"
            },
            {
                "p": "priceCap",
                "v": "500",
                "vt": "num"
            },
            {
                "p": "priceLevel",
                "v": "480",
                "vt": "num"
            },
            {
                "p": "minHours",
                "v": "2",
                "vt": "num"
            },
            {
                "p": "topic",
                "v": "myhome/heating",
                "vt": "str"
            },
            {
                "p": "startValue",
                "v": "on",
                "vt": "str"
            },
            {
                "p": "stopValue",
                "v": "off",
                "vt": "str"
            }
        ],
        "repeat": "",
